---
import { loadContent } from '../utils/content';

const { frontmatter } = loadContent('contact.md');

const title = frontmatter.title as string;
const headline = frontmatter.headline as string;
const scheduleUrl = frontmatter.scheduleUrl as string | undefined;
const calendarLabel = frontmatter.calendarLabel as string;
const calendarDescription = frontmatter.calendarDescription as string;
const telegramUrl = frontmatter.telegramUrl as string;
const telegramLabel = frontmatter.telegramLabel as string;
const telegramDescription = frontmatter.telegramDescription as string;

const hasScheduleUrl = typeof scheduleUrl === 'string' && scheduleUrl.length > 0;
---

<section id="booking" class="py-12 sm:py-24 px-4 bg-warm-white">
  <div class="max-w-5xl mx-auto">
    <div class="reveal flex items-center gap-4 mb-5">
      <div class="w-1 h-10 bg-sage rounded-full shrink-0"></div>
      <h2 class="font-heading text-4xl sm:text-5xl font-semibold text-warm-gray">
        {title}
      </h2>
    </div>

    <div class="reveal reveal-delay-1 mb-10 sm:mb-12">
      <p class="text-xl sm:text-2xl font-heading font-medium text-warm-gray">
        {headline}
      </p>
    </div>

    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Calendar booking -->
      <div class="reveal bg-warm-white rounded-2xl p-6 sm:p-8 border border-sage/15">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-full bg-sage/15 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-sage-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg font-semibold text-warm-gray">{calendarLabel}</h3>
        </div>
        <p class="text-warm-gray-light text-sm sm:text-base mb-5">
          {calendarDescription}
        </p>
        {hasScheduleUrl ? (
          <a
            href={scheduleUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-sage hover:bg-sage-dark text-white px-7 py-3 rounded-full text-sm font-medium tracking-wide transition-all duration-300 hover:shadow-lg hover:shadow-sage/25 hover:-translate-y-0.5"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {calendarLabel}
          </a>
        ) : (
          <p class="text-warm-gray-light text-sm">
            Ссылка на календарь записи будет добавлена позже.
          </p>
        )}
      </div>

      <!-- Telegram / messengers -->
      <div class="reveal bg-warm-white rounded-2xl p-6 sm:p-8 border border-sage/15">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-full bg-sage/15 flex items-center justify-center shrink-0">
            <svg class="w-5 h-5 text-sage-dark" viewBox="0 0 24 24" fill="currentColor">
              <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
            </svg>
          </div>
          <h3 class="font-heading text-lg font-semibold text-warm-gray">{telegramLabel}</h3>
        </div>
        <p class="text-warm-gray-light text-sm sm:text-base mb-5">
          {telegramDescription}
        </p>
        <a
          href={telegramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-sage hover:bg-sage-dark text-white px-7 py-3 rounded-full text-sm font-medium tracking-wide transition-all duration-300 hover:shadow-lg hover:shadow-sage/25 hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
          {telegramLabel}
        </a>
      </div>
    </div>
  </div>
</section>
